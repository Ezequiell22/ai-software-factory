POSTGRES_DB=ai_factory
POSTGRES_USER=ai_factory
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ai_factory:change-me@db:5432/ai_factory

APP_TIMEZONE=America/Sao_Paulo
WORK_START_HOUR=7
WORK_END_HOUR=19
RECONCILIATION_SECONDS=60
MAX_REFINEMENT_CYCLES=3
MAX_ATTACHMENT_MB=15
MAX_ATTACHMENT_CHARS=120000

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AIPTO
JIRA_IDEA_JQL=project = AIPTO AND status = Idea
JIRA_STORY_ISSUE_TYPE=Story
JIRA_UX_ISSUE_TYPE=Subtask
JIRA_ISSUE_LINK_TYPE=Relates

# Board lanes/statuses. Change these names if your Jira board uses others.
JIRA_AGENT_STATUS=Discovery
JIRA_HUMAN_STATUS=Human Approval
JIRA_STORY_STATUS=Specification
JIRA_UX_STATUS=UX/UI
JIRA_READY_STATUS=Engineering Ready
JIRA_DONE_STATUS=Done

JIRA_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
